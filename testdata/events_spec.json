{
  "spec": {
    "name": "GameStats Events Spec",
    "version": "1.0.0",
    "description": "Formato de entrada de eventos de GameStats. Estructura comun fija (envelope) + campo 'data' flexible por tipo de evento, de modo que Go no depende de un juego concreto.",
    "format": "JSON (UTF-8)",
    "timestampFormat": "ISO 8601 / RFC 3339 en UTC, con milisegundos. Ej: 2026-09-01T10:00:12.000Z",
    "initialGame": {
      "gameId": "fps-arena",
      "gameVersion": "1.0.0",
      "genre": "Combate / Shooter (FPS)",
      "justification": "Un FPS genera eventos discretos y frecuentes (disparos, impactos, eliminaciones) que permiten metricas por jugador (K/D, precision), por partida (duracion, MVP) y patrones temporales (rachas)."
    }
  },

  "envelope": {
    "description": "Campos comunes a TODOS los eventos, sin importar el juego.",
    "fields": {
      "eventId":     { "type": "string", "required": true,  "rules": "No vacio. Unico en todo el sistema (se recomienda UUID). Un eventId repetido se rechaza como DUPLICATE_EVENT." },
      "timestamp":   { "type": "string", "required": true,  "rules": "RFC 3339 en UTC. Momento en que ocurrio el evento en el juego." },
      "gameId":      { "type": "string", "required": true,  "rules": "No vacio. Identifica el juego que produjo el evento." },
      "gameVersion": { "type": "string", "required": true,  "rules": "No vacio. Version del juego." },
      "matchId":     { "type": "string", "required": true,  "rules": "No vacio. Agrupa todos los eventos de una misma partida." },
      "playerId":    { "type": "string|null", "required": "depende del tipo", "rules": "Obligatorio salvo en MATCH_STARTED y MATCH_FINISHED, donde debe ser null u omitirse." },
      "type":        { "type": "string", "required": true,  "rules": "Debe ser uno de los tipos definidos en 'eventTypes'." },
      "action":      { "type": "string|null", "required": "depende del tipo", "rules": "Obligatorio solo en PLAYER_ACTION. Debe ser uno de sus valores permitidos." },
      "data":        { "type": "object", "required": "depende del tipo", "rules": "Objeto con campos especificos del tipo/accion. Go solo valida los campos requeridos del tipo; los campos extra se aceptan y se reenvian a Scala sin modificar." }
    }
  },

  "eventTypes": {
    "MATCH_STARTED": {
      "description": "Inicio de una partida.",
      "playerId": "null",
      "action": "no aplica",
      "data": {
        "map":        { "type": "string",  "required": true },
        "mode":       { "type": "string",  "required": true, "example": "deathmatch" },
        "maxPlayers": { "type": "integer", "required": true, "rules": "> 0" }
      }
    },
    "PLAYER_JOINED": {
      "description": "Un jugador se une a la partida.",
      "playerId": "obligatorio",
      "action": "no aplica",
      "data": {
        "nickname": { "type": "string", "required": true },
        "team":     { "type": "string", "required": false }
      }
    },
    "PLAYER_ACTION": {
      "description": "Accion de un jugador durante la partida.",
      "playerId": "obligatorio",
      "action": {
        "allowed": ["SHOOT", "RELOAD", "MOVE", "PICKUP_ITEM"],
        "note": "SHOOT es la accion usada por las metricas de precision y dano. Las demas son opcionales y sirven para variedad del simulador."
      },
      "data": {
        "SHOOT": {
          "weapon":   { "type": "string",  "required": true },
          "hit":      { "type": "boolean", "required": true, "rules": "true si el disparo impacto a un jugador" },
          "damage":   { "type": "number",  "required": true, "rules": ">= 0. Debe ser 0 si hit=false" },
          "targetId": { "type": "string",  "required": false, "rules": "playerId impactado. Presente si hit=true" }
        },
        "RELOAD":      { "weapon": { "type": "string", "required": true } },
        "MOVE":        { "x": { "type": "number", "required": true }, "y": { "type": "number", "required": true } },
        "PICKUP_ITEM": { "item": { "type": "string", "required": true } }
      }
    },
    "PLAYER_ELIMINATED": {
      "description": "Un jugador elimina a otro. playerId es el ELIMINADOR (killer); la victima va en data.victimId.",
      "playerId": "obligatorio (killer)",
      "action": "no aplica",
      "data": {
        "victimId": { "type": "string",  "required": true, "rules": "Distinto de playerId" },
        "weapon":   { "type": "string",  "required": true },
        "distance": { "type": "number",  "required": false, "rules": ">= 0 (metros)" },
        "headshot": { "type": "boolean", "required": false }
      }
    },
    "MATCH_FINISHED": {
      "description": "Fin de la partida.",
      "playerId": "null",
      "action": "no aplica",
      "data": {
        "reason": { "type": "string", "required": true, "allowed": ["TIME_LIMIT", "SCORE_LIMIT", "ABORTED"] }
      }
    }
  },

  "validationRules": {
    "description": "Validaciones que realiza el modulo Go. Un evento que falla se rechaza (HTTP 400 con el codigo de error) y se registra en el log de rechazados.",
    "errorCodes": {
      "MALFORMED_JSON":       "El cuerpo no es JSON valido.",
      "MISSING_FIELD":        "Falta un campo obligatorio del envelope o de data.",
      "INVALID_TIMESTAMP":    "timestamp no cumple RFC 3339.",
      "UNKNOWN_TYPE":         "type no esta en eventTypes.",
      "UNKNOWN_ACTION":       "action no permitido para PLAYER_ACTION.",
      "INVALID_FIELD_VALUE":  "Valor fuera de rango o tipo incorrecto (damage negativo, victimId == playerId, etc.).",
      "DUPLICATE_EVENT":      "eventId ya recibido."
    },
    "stateRules": {
      "note": "Reglas opcionales que dependen del estado de la partida (Go las puede aplicar con el estado por matchId).",
      "rules": [
        "Un evento que no sea MATCH_STARTED para un matchId desconocido se acepta pero queda en estado 'pendiente' hasta recibir MATCH_STARTED (o se rechaza con UNKNOWN_MATCH, a decision del equipo).",
        "Despues de MATCH_FINISHED no se aceptan mas eventos de ese matchId (MATCH_ALREADY_FINISHED)."
      ]
    }
  },

  "metrics": {
    "perPlayer": {
      "kills":       "Cantidad de PLAYER_ELIMINATED donde playerId = jugador.",
      "deaths":      "Cantidad de PLAYER_ELIMINATED donde data.victimId = jugador.",
      "kdRatio":     "kills / deaths. Si deaths = 0, kdRatio = kills.",
      "shots":       "Cantidad de PLAYER_ACTION con action=SHOOT del jugador.",
      "hits":        "Cantidad de SHOOT con data.hit = true.",
      "accuracy":    "hits / shots (0.0 si shots = 0). Combina distintos eventos/acciones.",
      "totalDamage": "Suma de data.damage de los SHOOT del jugador."
    },
    "perMatch": {
      "durationSeconds": "timestamp(MATCH_FINISHED) - timestamp(MATCH_STARTED), en segundos.",
      "totalKills":      "Total de PLAYER_ELIMINATED en la partida.",
      "mvpPlayerId":     "Jugador con mas kills. Desempates en orden: mayor totalDamage, menos deaths, playerId alfabetico."
    },
    "complexPattern": {
      "name": "KILL_STREAK (racha de eliminaciones)",
      "definition": "Un jugador logra 3 o mas PLAYER_ELIMINATED (como killer) tales que, ordenadas por timestamp, la tercera ocurre en MENOS de 30 segundos despues de la primera.",
      "algorithm": "Para cada jugador, ordenar sus eliminaciones por timestamp. Una ventana deslizante de 3 eliminaciones consecutivas cumple si t[i+2] - t[i] < 30000 ms. Las ventanas que se solapan se fusionan en una sola racha: killCount = numero de eliminaciones de la racha, startTime = t[inicio], endTime = t[fin].",
      "parameters": { "minKills": 3, "windowMs": 30000 },
      "outputFields": ["playerId", "killCount", "startTime", "endTime", "durationMs"],
      "note": "Este calculo lo hace Scala, no Go."
    }
  },

  "validEventExamples": [
    {
      "description": "Inicio de partida",
      "event": {
        "eventId": "evt-0001", "timestamp": "2026-09-01T10:00:00.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": null, "type": "MATCH_STARTED",
        "data": { "map": "dust-valley", "mode": "deathmatch", "maxPlayers": 8 }
      }
    },
    {
      "description": "Un jugador se une",
      "event": {
        "eventId": "evt-0002", "timestamp": "2026-09-01T10:00:01.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_JOINED",
        "data": { "nickname": "Shadow", "team": "red" }
      }
    },
    {
      "description": "Disparo que impacta",
      "event": {
        "eventId": "evt-0003", "timestamp": "2026-09-01T10:00:11.500Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ACTION", "action": "SHOOT",
        "data": { "weapon": "rifle", "hit": true, "damage": 100, "targetId": "p2" }
      }
    },
    {
      "description": "Disparo fallido",
      "event": {
        "eventId": "evt-0004", "timestamp": "2026-09-01T10:00:19.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ACTION", "action": "SHOOT",
        "data": { "weapon": "rifle", "hit": false, "damage": 0 }
      }
    },
    {
      "description": "Eliminacion",
      "event": {
        "eventId": "evt-0005", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ELIMINATED",
        "data": { "victimId": "p2", "weapon": "rifle", "distance": 35.5, "headshot": true }
      }
    },
    {
      "description": "Fin de partida",
      "event": {
        "eventId": "evt-0006", "timestamp": "2026-09-01T10:01:00.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": null, "type": "MATCH_FINISHED",
        "data": { "reason": "TIME_LIMIT" }
      }
    },
    {
      "description": "Ejemplo de extensibilidad: otro juego (carreras) con la misma estructura. Go lo acepta sin cambios si el tipo se registra en la configuracion.",
      "event": {
        "eventId": "evt-9001", "timestamp": "2026-09-01T11:05:30.000Z",
        "gameId": "race-x", "gameVersion": "2.1.0", "matchId": "race-042",
        "playerId": "p7", "type": "LAP_COMPLETED",
        "data": { "lap": 3, "lapTimeMs": 84250, "position": 2 }
      }
    }
  ],

  "invalidEventExamples": [
    {
      "description": "Falta matchId",
      "expectedError": "MISSING_FIELD",
      "event": {
        "eventId": "evt-bad-01", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0",
        "playerId": "p1", "type": "PLAYER_ELIMINATED",
        "data": { "victimId": "p2", "weapon": "rifle" }
      }
    },
    {
      "description": "eventId vacio",
      "expectedError": "MISSING_FIELD",
      "event": {
        "eventId": "", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_JOINED",
        "data": { "nickname": "Shadow" }
      }
    },
    {
      "description": "Timestamp con formato invalido",
      "expectedError": "INVALID_TIMESTAMP",
      "event": {
        "eventId": "evt-bad-03", "timestamp": "12/09/2026 10:00",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_JOINED",
        "data": { "nickname": "Shadow" }
      }
    },
    {
      "description": "Tipo de evento desconocido",
      "expectedError": "UNKNOWN_TYPE",
      "event": {
        "eventId": "evt-bad-04", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_TELEPORTED",
        "data": {}
      }
    },
    {
      "description": "PLAYER_ACTION sin action",
      "expectedError": "MISSING_FIELD",
      "event": {
        "eventId": "evt-bad-05", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ACTION",
        "data": { "weapon": "rifle", "hit": true, "damage": 50 }
      }
    },
    {
      "description": "PLAYER_ACTION con action no permitido",
      "expectedError": "UNKNOWN_ACTION",
      "event": {
        "eventId": "evt-bad-06", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ACTION", "action": "FLY",
        "data": {}
      }
    },
    {
      "description": "PLAYER_ELIMINATED sin victimId",
      "expectedError": "MISSING_FIELD",
      "event": {
        "eventId": "evt-bad-07", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ELIMINATED",
        "data": { "weapon": "rifle" }
      }
    },
    {
      "description": "Un jugador se elimina a si mismo (victimId == playerId)",
      "expectedError": "INVALID_FIELD_VALUE",
      "event": {
        "eventId": "evt-bad-08", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ELIMINATED",
        "data": { "victimId": "p1", "weapon": "rifle" }
      }
    },
    {
      "description": "Dano negativo",
      "expectedError": "INVALID_FIELD_VALUE",
      "event": {
        "eventId": "evt-bad-09", "timestamp": "2026-09-01T10:00:12.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": "p1", "type": "PLAYER_ACTION", "action": "SHOOT",
        "data": { "weapon": "rifle", "hit": true, "damage": -20, "targetId": "p2" }
      }
    },
    {
      "description": "PLAYER_JOINED sin playerId",
      "expectedError": "MISSING_FIELD",
      "event": {
        "eventId": "evt-bad-10", "timestamp": "2026-09-01T10:00:01.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": null, "type": "PLAYER_JOINED",
        "data": { "nickname": "Ghost" }
      }
    },
    {
      "description": "Evento duplicado (mismo eventId ya recibido, ej. evt-0001)",
      "expectedError": "DUPLICATE_EVENT",
      "event": {
        "eventId": "evt-0001", "timestamp": "2026-09-01T10:00:00.000Z",
        "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001",
        "playerId": null, "type": "MATCH_STARTED",
        "data": { "map": "dust-valley", "mode": "deathmatch", "maxPlayers": 8 }
      }
    },
    {
      "description": "JSON mal formado (se envia como texto crudo)",
      "expectedError": "MALFORMED_JSON",
      "rawBody": "{ \"eventId\": \"evt-bad-12\", \"type\": \"MATCH_STARTED\", "
    }
  ],

  "goToScalaContract": {
    "description": "Contrato entre el modulo Go y el modulo Scala (HTTP/REST). Go envia UNA partida completa y ordenada por timestamp cuando la considera lista para analizar (por ejemplo, al recibir MATCH_FINISHED). Scala no necesita conocer la implementacion interna de Go.",
    "request": {
      "method": "POST",
      "path": "/analyze",
      "contentType": "application/json",
      "body": {
        "matchId": "string",
        "gameId": "string",
        "gameVersion": "string",
        "sentAt": "timestamp RFC 3339",
        "events": "arreglo de eventos validos con el envelope definido arriba, ORDENADOS por timestamp ascendente"
      }
    },
    "response": {
      "status": "200 OK con el resultado, 400 si el payload es invalido, 500 en error interno",
      "body": {
        "matchId": "string",
        "gameId": "string",
        "matchStats": {
          "durationSeconds": "number",
          "totalKills": "number",
          "mvpPlayerId": "string|null"
        },
        "playerStats": "arreglo de { playerId, kills, deaths, kdRatio, shots, hits, accuracy, totalDamage }",
        "patterns": {
          "killStreaks": "arreglo de { playerId, killCount, startTime, endTime, durationMs }"
        }
      }
    },
    "requestExample": {
      "matchId": "match-001",
      "gameId": "fps-arena",
      "gameVersion": "1.0.0",
      "sentAt": "2026-09-01T10:01:01.000Z",
      "events": [
        { "eventId": "e1", "timestamp": "2026-09-01T10:00:00.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": null, "type": "MATCH_STARTED", "data": { "map": "dust-valley", "mode": "deathmatch", "maxPlayers": 8 } },
        { "eventId": "e2", "timestamp": "2026-09-01T10:00:01.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p1", "type": "PLAYER_JOINED", "data": { "nickname": "Shadow", "team": "red" } },
        { "eventId": "e3", "timestamp": "2026-09-01T10:00:02.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p2", "type": "PLAYER_JOINED", "data": { "nickname": "Viper", "team": "blue" } },
        { "eventId": "e4", "timestamp": "2026-09-01T10:00:11.500Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p1", "type": "PLAYER_ACTION", "action": "SHOOT", "data": { "weapon": "rifle", "hit": true, "damage": 100, "targetId": "p2" } },
        { "eventId": "e5", "timestamp": "2026-09-01T10:00:12.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p1", "type": "PLAYER_ELIMINATED", "data": { "victimId": "p2", "weapon": "rifle", "distance": 35.5, "headshot": true } },
        { "eventId": "e6", "timestamp": "2026-09-01T10:00:19.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p1", "type": "PLAYER_ACTION", "action": "SHOOT", "data": { "weapon": "rifle", "hit": false, "damage": 0 } },
        { "eventId": "e7", "timestamp": "2026-09-01T10:00:20.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p1", "type": "PLAYER_ELIMINATED", "data": { "victimId": "p2", "weapon": "rifle", "distance": 12.0, "headshot": false } },
        { "eventId": "e8", "timestamp": "2026-09-01T10:00:33.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": "p1", "type": "PLAYER_ELIMINATED", "data": { "victimId": "p2", "weapon": "pistol", "distance": 5.0, "headshot": false } },
        { "eventId": "e9", "timestamp": "2026-09-01T10:01:00.000Z", "gameId": "fps-arena", "gameVersion": "1.0.0", "matchId": "match-001", "playerId": null, "type": "MATCH_FINISHED", "data": { "reason": "TIME_LIMIT" } }
      ]
    },
    "expectedResponseExample": {
      "matchId": "match-001",
      "gameId": "fps-arena",
      "matchStats": { "durationSeconds": 60, "totalKills": 3, "mvpPlayerId": "p1" },
      "playerStats": [
        { "playerId": "p1", "kills": 3, "deaths": 0, "kdRatio": 3.0, "shots": 2, "hits": 1, "accuracy": 0.5, "totalDamage": 100 },
        { "playerId": "p2", "kills": 0, "deaths": 3, "kdRatio": 0.0, "shots": 0, "hits": 0, "accuracy": 0.0, "totalDamage": 0 }
      ],
      "patterns": {
        "killStreaks": [
          { "playerId": "p1", "killCount": 3, "startTime": "2026-09-01T10:00:12.000Z", "endTime": "2026-09-01T10:00:33.000Z", "durationMs": 21000 }
        ]
      }
    }
  },

  "goInternalNotes": {
    "extensibility": "Los tipos de evento y sus campos obligatorios de 'data' se cargan desde configuracion (por ejemplo, un archivo JSON de tipos), no estan fijos en el codigo. Asi se incorpora un nuevo juego sin modificar el nucleo.",
    "readyToAnalyze": "Una partida se considera lista cuando llega MATCH_FINISHED. Si hay un timeout de inactividad configurable, Go puede enviarla igual marcandola como incompleta."
  }
}
